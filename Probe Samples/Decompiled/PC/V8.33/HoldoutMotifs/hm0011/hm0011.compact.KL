PROGRAM HM0011
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM HM0011
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : INTEGER
U2C_5 : INTEGER
U2C_6 : INTEGER
BEGIN
U2C_4=1
U2C_5=1
U2C_6=1
IF (((U2C_4=1) AND (U2C_5=1)) AND (U2C_6=1)) THEN
G=1
ENDIF
END R
BEGIN
R
END HM0011
