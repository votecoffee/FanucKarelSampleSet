PROGRAM OI0020
%NOLOCKGROUP
TYPE
T=STRUCTURE
N:INTEGER
S : STRING[2]
ENDSTRUCTURE
U=STRUCTURE
M : ARRAY[2,3] OF T
ENDSTRUCTURE
VAR
G : U
ROUTINE R(P1:U)
VAR
L1 : ARRAY[2] OF INTEGER;A:INTEGER
BEGIN
--                                                
A=P1.M[1,2].N    
P1.M[2,1].N=A    
END R
BEGIN  
R(G)   
END OI0020
