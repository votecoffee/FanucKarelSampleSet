PROGRAM B2C0102
%NOLOCKGROUP
TYPE
T=STRUCTURE
N:INTEGER
S : STRING[2]
ENDSTRUCTURE
U=STRUCTURE
C : T
M : ARRAY[2,3] OF T
ENDSTRUCTURE
VAR
G : U
ROUTINE R(P1:U)
VAR
L1 : ARRAY[2] OF INTEGER;A:INTEGER
BEGIN
--                                             
P1.M[1,2].N=41   
A=P1.M[1,2].N    
END R
BEGIN  
R(G)   
END B2C0102
