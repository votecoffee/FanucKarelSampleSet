PROGRAM C790009
%NOLOCKGROUP
VAR
  D1 : INTEGER
  D2 : INTEGER
  D3 : INTEGER
  D4 : INTEGER
  D5 : INTEGER
  D6 : INTEGER
  D7 : INTEGER
  D8 : INTEGER
  D9 : INTEGER
  CAM_GO : ARRAY[4,5] OF INTEGER
  G : INTEGER
ROUTINE R(P : INTEGER)
VAR
  A : ARRAY[7] OF INTEGER
  X : REAL
BEGIN
  X = 1.0
  IF X = CAM_GO[P,3] THEN
   G = 1
  ENDIF
  X = 0.0
END R
BEGIN
  R(1)
END C790009
