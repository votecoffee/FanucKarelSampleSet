PROGRAM C790016
%NOLOCKGROUP
VAR
  D1 : INTEGER
  D2 : INTEGER
  D3 : INTEGER
  D4 : INTEGER
  D5 : INTEGER
  D6 : INTEGER
  D7 : INTEGER
  D8 : INTEGER
  D9 : INTEGER
  CAM_GO : ARRAY[4,5] OF INTEGER
  G : INTEGER
ROUTINE R(P : INTEGER; Q : INTEGER)
VAR
  A : ARRAY[7] OF INTEGER
  X : INTEGER
BEGIN
  D1 = D1
  D2 = D2
  D3 = D3
  D4 = D4
  D5 = D5
  D6 = D6
  D7 = D7
  D8 = D8
  D9 = D9
  X = 1
  IF X = CAM_GO[P,3] THEN
   G = 1
  ENDIF
END R
BEGIN
  R(1,0)
END C790016
