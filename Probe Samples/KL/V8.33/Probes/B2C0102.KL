PROGRAM B2C0102
%NOLOCKGROUP
TYPE
  T = STRUCTURE
    N : INTEGER
    S : STRING[2]
  ENDSTRUCTURE
  U = STRUCTURE
    C : T
    M : ARRAY[2,3] OF T
  ENDSTRUCTURE
VAR
  G : U
ROUTINE R(P : U)
VAR
  A : ARRAY[2] OF INTEGER
  X : INTEGER
BEGIN
  P.M[1,2].N = 41
  X = P.M[1,2].N
END R
BEGIN
  R(G)
END B2C0102
