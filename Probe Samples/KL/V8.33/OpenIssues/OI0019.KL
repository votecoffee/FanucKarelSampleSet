PROGRAM OI0019
%NOLOCKGROUP
TYPE
  T = STRUCTURE
    N : INTEGER
    S : STRING[2]
  ENDSTRUCTURE
  U = STRUCTURE
    R1 : REAL
    N : INTEGER
  ENDSTRUCTURE
VAR
  G : T
  H : U
ROUTINE R(P : T; Q : U)
VAR
  A : ARRAY[2] OF INTEGER
  X : INTEGER
BEGIN
  X = P.N
  Q.N = X
END R
BEGIN
  R(G,H)
END OI0019
