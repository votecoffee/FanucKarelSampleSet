PROGRAM BYTEPROBE
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G1 : XYZWPR
ROUTINE R(P1 : STRING; P2 : STRING; P3 : STRING; P4 : STRING; P5 : XYZWPR) FROM BYTEPROBE
ROUTINE R
VAR
L1 : ARRAY[7] OF STRING[8]
BEGIN
L1[1]=P1
L1[2]=P2
L1[3]=P3
L1[4]=P4
END R
BEGIN
R('A','B','C','D',G1)
END BYTEPROBE
