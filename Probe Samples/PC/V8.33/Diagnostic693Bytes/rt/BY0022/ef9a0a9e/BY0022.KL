PROGRAM BYTEPROBE
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R(P1 : STRING) FROM BYTEPROBE
ROUTINE R
VAR
L1 : ARRAY[150] OF STRING[8]
BEGIN
-- UNRESOLVED_PC line 9 opcodes [3F 22 9D 33 61] marker_code=8
-- UNRESOLVED_PC line 10 opcodes [22 9D 33 5E 74 83 79] marker_code=25
G=1
END R
BEGIN
R('A')
END BYTEPROBE
