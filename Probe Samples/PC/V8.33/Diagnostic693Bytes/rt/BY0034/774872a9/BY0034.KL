PROGRAM BYTEPROBE
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G1 : XYZWPR
G2 : XYZWPR
G3 : XYZWPR
ROUTINE R(P1 : STRING; P2 : STRING; P3 : XYZWPR; P4 : XYZWPR; P5 : XYZWPR) FROM BYTEPROBE
ROUTINE R
VAR
L1 : ARRAY[1] OF BOOLEAN
L2 : ARRAY[14] OF STRING[8]
BEGIN
L2[1]=P1
L2[2]=P2
END R
BEGIN
R('A','B',G1,G2,G3)
END BYTEPROBE
