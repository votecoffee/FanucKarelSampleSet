PROGRAM DX0033
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R : INTEGER FROM DX0033
ROUTINE R
VAR
U2C_1 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_1=1
-- UNSAFE_SOURCE_IR line 10: SELECT FRAME[R+0x1] OF
CASE(1):
RETURN(141)
CASE(2):
RETURN(142)
ELSE:
RETURN(143)
ENDSELECT
-- UNRESOLVED_PC line 15 opcodes [7F] marker_code=111
END R
BEGIN
G=R
END DX0033
