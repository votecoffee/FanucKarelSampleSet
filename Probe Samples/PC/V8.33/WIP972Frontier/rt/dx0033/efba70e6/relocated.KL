PROGRAM DX0033
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R : INTEGER FROM DX0033
ROUTINE R
VAR
U2C_1 : INTEGER
BEGIN
U2C_1=1
SELECT U2C_1 OF
CASE(1):
RETURN(141)
CASE(2):
RETURN(142)
ELSE:
RETURN(143)
ENDSELECT
END R
BEGIN
G=R
END DX0033
