PROGRAM DX0022
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM DX0022
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_5 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_4=1
U2C_5=(NOT U2C_4)
IF (U2C_4 AND U2C_5) THEN
G=1
ENDIF
END R
BEGIN
R
END DX0022
