PROGRAM DX0038
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM DX0038
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
S1 : INTEGER
BEGIN
U2C_4=TRUE
FOR S1=1 TO 2 DO
IF (U2C_4=TRUE) THEN
G=S1
ENDIF
ENDFOR
END R
BEGIN
R
END DX0038
