PROGRAM DX0029
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM DX0029
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_5 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_4=1
U2C_5=FALSE
-- UNSAFE_SOURCE_IR line 13: SELECT FRAME[R+0x4] OF
CASE(1):
IF (U2C_5=FALSE) THEN
G=1
ENDIF
CASE(2):
U2C_5=TRUE
ENDSELECT
END R
BEGIN
R
END DX0029
