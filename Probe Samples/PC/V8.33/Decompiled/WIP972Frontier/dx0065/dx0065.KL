PROGRAM DX0065
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
F : FILE
ROUTINE R(P1 : INTEGER; P2 : STRING) FROM DX0065
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_5 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
READ_KB(F,P2,1,1,2,-1,'',U2C_4,P1,U2C_5)
G=U2C_5
END R
BEGIN
R(1,'')
END DX0065
