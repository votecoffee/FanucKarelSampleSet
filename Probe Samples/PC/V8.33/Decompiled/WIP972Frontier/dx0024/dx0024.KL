PROGRAM DX0024
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM DX0024
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
S1 : INTEGER
BEGIN
U2C_4=TRUE
S1=1
WHILE (S1 < 2) DO
IF (U2C_4=FALSE) THEN
G=2
ENDIF
S1=(S1 + 1)
ENDWHILE
END R
BEGIN
R
END DX0024
