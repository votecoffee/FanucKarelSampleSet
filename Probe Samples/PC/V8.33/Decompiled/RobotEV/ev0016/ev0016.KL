PROGRAM EV0016
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE R FROM EV0016
ROUTINE DAQ_REGPIPE(arg1 : INTEGER; arg2 : INTEGER; arg3 : INTEGER; arg4 : STRING; arg5 : STRING; arg6 : STRING; arg7 : INTEGER; arg8 : INTEGER) FROM PBDAQ
ROUTINE R
VAR
L1 : STRING[32]
L2 : STRING[32]
L3 : STRING[32]
S1 : INTEGER
S2 : INTEGER
S3 : INTEGER
S4 : INTEGER
S5 : INTEGER
BEGIN
DAQ_REGPIPE(S1,S2,S3,L1,L2,L3,S4,S5)
END R
BEGIN
R
END EV0016
