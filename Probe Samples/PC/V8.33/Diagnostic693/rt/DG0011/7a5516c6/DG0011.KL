PROGRAM DGCASE
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM DGCASE
ROUTINE R
VAR
U2C_1 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_2 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
U2C_3 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_1=1
U2C_2=TRUE
U2C_3=TRUE
IF (((U2C_1=1) AND (U2C_2=TRUE)) AND (U2C_3=TRUE)) THEN
G=U2C_1
ENDIF
END R
BEGIN
R
END DGCASE
