PROGRAM DGCASE
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM DGCASE
ROUTINE R
VAR
L1 : ARRAY[2] OF STRING[8]
L2 : STRING[8]
U2C_11 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_11=1
-- UNRESOLVED_PC line 12 opcodes [3F 22 21 33 61] marker_code=26
-- UNRESOLVED_PC line 13 opcodes [22 21 33 5E 75] marker_code=48
IF (L2='A') THEN
G=U2C_11
ENDIF
END R
BEGIN
R
END DGCASE
