PROGRAM DGCASE
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R(P1 : INTEGER) FROM DGCASE
ROUTINE R
VAR
U2C_1 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_1=1
-- UNRESOLVED_PC line 10 opcodes [03 2D 1B 9D 12 13 04 14] marker_code=20
G=U2C_1
END R
BEGIN
R(1)
END DGCASE
