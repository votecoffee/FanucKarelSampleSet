PROGRAM DGCASE
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM DGCASE
ROUTINE R
VAR
U2C_1 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_2 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_1=1
-- UNSAFE_SOURCE_IR line 10: SELECT FRAME[R+0x1] OF
CASE(0):
U2C_2=0
CASE(1):
U2C_2=141
ELSE:
U2C_2=2
ENDSELECT
G=U2C_2
END R
BEGIN
R
END DGCASE
