PROGRAM FY0012
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FY0012
ROUTINE R
VAR
U2C_1 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
U2C_2 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_1=TRUE
U2C_2=TRUE
IF (U2C_2=TRUE) THEN
IF (U2C_1=TRUE) THEN
G=2
ELSE
G=3
ENDIF
ENDIF
END R
BEGIN
R
END FY0012
