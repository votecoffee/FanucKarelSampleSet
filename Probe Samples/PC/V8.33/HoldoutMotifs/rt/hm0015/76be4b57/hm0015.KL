PROGRAM HM0015
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM HM0015
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
U2C_5 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_6 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_4=TRUE
U2C_5=1
U2C_6=TRUE
IF (((U2C_4=TRUE) AND (U2C_5 <> 1)) AND (U2C_6=TRUE)) THEN
G=1
ENDIF
END R
BEGIN
R
END HM0015
