PROGRAM HM0030
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
F : FILE
ROUTINE R(P1 : INTEGER; P2 : STRING) FROM HM0030
ROUTINE R
VAR
U2C_1 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_2 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
READ_KB(F,P2,1,1,2,-1,'',U2C_1,P1,U2C_2)
G=U2C_2
END R
BEGIN
R(1,'')
END HM0030
