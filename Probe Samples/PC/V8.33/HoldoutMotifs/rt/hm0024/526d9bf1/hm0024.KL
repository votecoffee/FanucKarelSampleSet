PROGRAM HM0024
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
F : FILE
ROUTINE R FROM HM0024
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[32]
U2C_13 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_14 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
READ_KB(F,L2,1,1,((((2 + 64) + 1) + 16) + 8),-1,'',U2C_13,U2C_14,G)
END R
BEGIN
R
END HM0024
