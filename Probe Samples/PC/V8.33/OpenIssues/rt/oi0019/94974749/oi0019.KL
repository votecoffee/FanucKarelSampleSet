PROGRAM OI0019
%NOLOCKGROUP
TYPE
T=STRUCTURE
N:INTEGER
S : STRING[2]
ENDSTRUCTURE
U=STRUCTURE
R1:REAL
N:INTEGER
ENDSTRUCTURE
VAR
G : T
H : U
ROUTINE R(P1:T;P2:U)
VAR
L1 : ARRAY[2] OF INTEGER;A:INTEGER
BEGIN
--                                                              
A=P1.N    
P2.N=A    
END R
BEGIN  
R(G,H)   
END OI0019
