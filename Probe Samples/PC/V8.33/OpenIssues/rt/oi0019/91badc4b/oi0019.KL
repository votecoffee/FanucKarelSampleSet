PROGRAM OI0019
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
TYPE
T=STRUCTURE
N : INTEGER
S : STRING[2]
ENDSTRUCTURE
U=STRUCTURE
R1 : REAL
N : INTEGER
ENDSTRUCTURE
VAR
G : T
H : U
ROUTINE R(P1 : T; P2 : U) FROM OI0019
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : INTEGER
BEGIN
U2C_4=P1.N
P2.N=U2C_4
END R
BEGIN
R(G,H)
END OI0019
