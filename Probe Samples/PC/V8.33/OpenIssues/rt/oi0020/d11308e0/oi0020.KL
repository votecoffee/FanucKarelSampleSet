PROGRAM OI0020
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
TYPE
T=STRUCTURE
N : INTEGER
S : STRING[2]
ENDSTRUCTURE
U=STRUCTURE
M : ARRAY[2,3] OF T
ENDSTRUCTURE
VAR
G : U
ROUTINE R(P1 : U) FROM OI0020
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : INTEGER
BEGIN
U2C_4=P1.M[1,2].N
P1.M[2,1].N=U2C_4
END R
BEGIN
R(G)
END OI0020
