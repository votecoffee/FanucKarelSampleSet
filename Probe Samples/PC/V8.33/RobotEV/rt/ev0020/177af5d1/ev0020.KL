PROGRAM EV0020
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE R FROM EV0020
ROUTINE DAQ_WRITE(arg1 : INTEGER; arg2 : STRING; arg3 : STRING; arg4 : INTEGER) FROM PBDAQ
ROUTINE R
VAR
L1 : STRING[32]
L2 : STRING[32]
S1 : INTEGER
S2 : INTEGER
BEGIN
DAQ_WRITE(S1,L1,L2,S2)
END R
BEGIN
R
END EV0020
