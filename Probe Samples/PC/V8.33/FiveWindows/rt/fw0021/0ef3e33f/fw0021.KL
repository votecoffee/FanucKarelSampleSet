PROGRAM FW0021
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FW0021
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[16]
U2C_9 : INTEGER
U2C_10 : INTEGER
U2C_11 : REAL
U2C_12 : REAL
U2C_13 : REAL
BEGIN
U2C_9=1
U2C_10=1
-- UNRESOLVED_PC line 15 opcodes [03 21 1B 9D 12 13 04 14] marker_code=38
IF (U2C_9=0) THEN
G=1
ENDIF
END R
BEGIN
R
END FW0021
