PROGRAM FW0008
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FW0008
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[16]
U2C_9 : INTEGER
U2C_10 : BOOLEAN
U2C_11 : REAL
U2C_12 : REAL
U2C_13 : REAL
BEGIN
U2C_9=1
U2C_10=TRUE
L2='A'
IF (U2C_9=0) THEN
G=1
ENDIF
END R
BEGIN
R
END FW0008
