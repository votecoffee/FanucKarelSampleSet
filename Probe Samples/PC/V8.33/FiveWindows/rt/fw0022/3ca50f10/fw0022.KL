PROGRAM FW0022
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FW0022
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[16]
U2C_9 : INTEGER
U2C_10 : INTEGER
U2C_11 : REAL
U2C_12 : REAL
U2C_13 : REAL
BEGIN
U2C_9=1
U2C_10=1
SELECT U2C_10 OF
CASE(1):
IF (U2C_9=0) THEN
G=1
ENDIF
CASE(2):
U2C_9=1
ENDSELECT
END R
BEGIN
R
END FW0022
