PROGRAM FW0014
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FW0014
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[16]
U2C_9 : INTEGER
U2C_10 : INTEGER
U2C_11 : REAL
U2C_12 : REAL
U2C_13 : REAL
BEGIN
U2C_9=1
U2C_10=1
IF (U2C_10=1) THEN
G=2
ELSE
G=3
ENDIF
IF (U2C_9=0) THEN
G=1
ENDIF
END R
BEGIN
R
END FW0014
