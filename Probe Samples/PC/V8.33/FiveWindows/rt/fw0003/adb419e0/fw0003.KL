PROGRAM FW0003
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FW0003
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[16]
U2C_9 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
U2C_10 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_11 : REAL -- ASSUMED 2C source type; see uncertainty report
U2C_12 : REAL -- ASSUMED 2C source type; see uncertainty report
U2C_13 : REAL -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_9=TRUE
U2C_10=1
IF (U2C_10=2) THEN
G=2
ENDIF
IF (U2C_9=FALSE) THEN
G=1
ENDIF
END R
BEGIN
R
END FW0003
