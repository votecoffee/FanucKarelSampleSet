PROGRAM FW0004
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FW0004
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[16]
U2C_9 : BOOLEAN -- ASSUMED 2C source type; see uncertainty report
S1 : INTEGER
U2C_11 : REAL -- ASSUMED 2C source type; see uncertainty report
U2C_12 : REAL -- ASSUMED 2C source type; see uncertainty report
U2C_13 : REAL -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_9=TRUE
S1=1
FOR S1=1 TO 2 DO
IF (U2C_9=FALSE) THEN
G=1
ENDIF
ENDFOR
END R
BEGIN
R
END FW0004
