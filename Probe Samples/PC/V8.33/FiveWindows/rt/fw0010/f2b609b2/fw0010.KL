PROGRAM FW0010
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM FW0010
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
L2 : STRING[16]
U2C_9 : INTEGER
U2C_10 : BOOLEAN
S1 : VECTOR
BEGIN
U2C_9=1
U2C_10=TRUE
-- UNRESOLVED_PC line 15 opcodes [49 4A] marker_code=38
IF (U2C_9=0) THEN
G=1
ENDIF
END R
BEGIN
R
END FW0010
