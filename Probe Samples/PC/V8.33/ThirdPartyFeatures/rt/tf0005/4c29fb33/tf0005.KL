PROGRAM TF0005
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
VAR
G : INTEGER
ROUTINE R FROM TF0005
ROUTINE R
VAR
L1 : ARRAY[3] OF INTEGER
U2C_5 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_5=ARRAY_LEN(L1)
IF UNINIT(L1[1]) THEN
L1[1]=U2C_5
ENDIF
G=L1[1]
END R
BEGIN
R
END TF0005
