PROGRAM WC0029
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE R FROM WC0029
ROUTINE R
VAR
L1 : ARRAY[2] OF INTEGER
U2C_4 : INTEGER -- ASSUMED 2C source type; see uncertainty report
U2C_5 : INTEGER -- ASSUMED 2C source type; see uncertainty report
BEGIN
U2C_4=1
U2C_5=(NOT U2C_4)
IF ((U2C_4 AND U2C_5) OR U2C_4) THEN
U2C_4=0
ENDIF
END R
BEGIN
R
END WC0029
