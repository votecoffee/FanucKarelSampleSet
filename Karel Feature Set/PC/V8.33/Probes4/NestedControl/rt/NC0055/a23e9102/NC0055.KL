PROGRAM NC0055
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE R FROM NC0055
ROUTINE R
VAR
S1 : INTEGER
BEGIN
S1=1
SELECT S1 OF
CASE(1):
S1=(S1 + 2)
CASE(2):
S1=(S1 + 3)
ELSE:
IF (S1=1) THEN
S1=(S1 + 2)
ELSE
SELECT S1 OF
CASE(1):
S1=(S1 + 2)
CASE(2):
S1=(S1 + 3)
ELSE:
IF (S1=1) THEN
S1=(S1 + 2)
ELSE
SELECT S1 OF
CASE(1):
S1=(S1 + 2)
CASE(2):
S1=(S1 + 3)
ELSE:
S1=(S1 + 1)
ENDSELECT
ENDIF
ENDSELECT
ENDIF
ENDSELECT
END R
BEGIN
R
END NC0055
