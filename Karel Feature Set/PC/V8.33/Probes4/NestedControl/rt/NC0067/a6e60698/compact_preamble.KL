PROGRAM NC0067
%NOLOCKGROUP
ROUTINE R
VAR
S1:INTEGER;S2:INTEGER;S3:INTEGER;S4:INTEGER;S5:INTEGER;S6:INTEGER;S7:INTEGER;S8:INTEGER;S9:INTEGER;S10:INTEGER;S11:INTEGER
BEGIN
S1=1
FOR S2=1 TO 2 DO
FOR S3=1 TO 2 DO
FOR S4=1 TO 2 DO
FOR S5=1 TO 2 DO
FOR S6=1 TO 2 DO
FOR S7=1 TO 2 DO
FOR S8=1 TO 2 DO
FOR S9=1 TO 2 DO
FOR S10=1 TO 2 DO
FOR S11=1 TO 2 DO
S1=(S1 + 1)
ENDFOR
ENDFOR
ENDFOR
ENDFOR
ENDFOR
ENDFOR
ENDFOR
ENDFOR
ENDFOR
ENDFOR
END R
BEGIN
R
END NC0067
