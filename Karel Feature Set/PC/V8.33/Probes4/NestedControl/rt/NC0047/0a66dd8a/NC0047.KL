PROGRAM NC0047
%NOLOCKGROUP
ROUTINE R
VAR
S1:INTEGER
BEGIN         
S1=1    
IF (S1=1) THEN  
SELECT S1 OF
CASE(1):           
IF (S1=1) THEN        
SELECT S1 OF
CASE(1):                       
IF (S1=1) THEN              
SELECT S1 OF
CASE(1):                                   
IF (S1=1) THEN                    
SELECT S1 OF
CASE(1):                                               
IF (S1=1) THEN                          
SELECT S1 OF
CASE(1):                                                           
S1=(S1+1)
CASE(2):                                                                
S1=(S1+2)
ELSE:                                                                
S1=(S1+3)                                 
ENDSELECT                             
ELSE                           
S1=(S1+2)                             
ENDIF
CASE(2):                                                    
S1=(S1+2)
ELSE:                                                    
S1=(S1+3)                           
ENDSELECT                       
ELSE                     
S1=(S1+2)                       
ENDIF
CASE(2):                                        
S1=(S1+2)
ELSE:                                        
S1=(S1+3)                     
ENDSELECT                 
ELSE               
S1=(S1+2)                 
ENDIF
CASE(2):                            
S1=(S1+2)
ELSE:                            
S1=(S1+3)               
ENDSELECT           
ELSE         
S1=(S1+2)           
ENDIF
CASE(2):                
S1=(S1+2)
ELSE:                
S1=(S1+3)         
ENDSELECT     
ELSE   
S1=(S1+2)     
ENDIF   
END R
BEGIN  
R   
END NC0047
