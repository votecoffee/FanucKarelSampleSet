PROGRAM NC0085
%NOLOCKGROUP
ROUTINE R
VAR
S1:INTEGER;S2:INTEGER
BEGIN
--           
S1=1    
IF (S1=1) THEN  
SELECT S1 OF
CASE(1):           
FOR S2=1 TO 2 DO           
WHILE (S1<2) DO          
IF (S1=1) THEN            
S1=(S1+1)               
ELSE             
S1=(S1+2)               
ENDIF             
ENDWHILE           
ENDFOR
CASE(2):                
S1=(S1+2)
ELSE:                
S1=(S1+3)         
ENDSELECT     
ELSE   
S1=(S1+2)     
ENDIF   
END R
BEGIN  
R   
END NC0085
