PROGRAM NC0087
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE R FROM NC0087
ROUTINE R
VAR
S1 : INTEGER
S2 : INTEGER
S3 : INTEGER
BEGIN
S1=1
IF (S1=1) THEN
SELECT S1 OF
CASE(1):
FOR S2=1 TO 2 DO
WHILE (S1 < 2) DO
IF (S1=1) THEN
SELECT S1 OF
CASE(1):
FOR S3=1 TO 2 DO
WHILE (S1 < 2) DO
IF (S1=1) THEN
SELECT S1 OF
CASE(1):
S1=(S1 + 1)
CASE(2):
S1=(S1 + 2)
ELSE:
S1=(S1 + 3)
ENDSELECT
ELSE
S1=(S1 + 2)
ENDIF
ENDWHILE
ENDFOR
CASE(2):
S1=(S1 + 2)
ELSE:
S1=(S1 + 3)
ENDSELECT
ELSE
S1=(S1 + 2)
ENDIF
ENDWHILE
ENDFOR
CASE(2):
S1=(S1 + 2)
ELSE:
S1=(S1 + 3)
ENDSELECT
ELSE
S1=(S1 + 2)
ENDIF
END R
BEGIN
R
END NC0087
