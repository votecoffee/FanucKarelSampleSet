PROGRAM MP0030
%NOLOCKGROUP
ROUTINE FINT(P1:INTEGER):INTEGER
BEGIN
RETURN((P1 + 1))
END FINT
ROUTINE FREAL(P1:REAL):REAL
BEGIN
RETURN((P1 + 1.0))
END FREAL
ROUTINE RTEST(P1:INTEGER;P2:REAL)
VAR
A:INTEGER;B:INTEGER;C:INTEGER;D:REAL;E:REAL;F:REAL;G:REAL;S1:REAL
BEGIN
A=7
B=3
C=2
D=2.5
E=4.5
F=1.5
S1=(D / (A))
END RTEST
BEGIN
RTEST(7,2.5)
END MP0030
