PROGRAM MP0009
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE FINT(P1 : INTEGER) : INTEGER FROM MP0009
ROUTINE FREAL(P1 : REAL) : REAL FROM MP0009
ROUTINE RTEST(P1 : INTEGER; P2 : REAL) FROM MP0009
ROUTINE FINT
BEGIN
RETURN((P1 + 1))
END FINT
ROUTINE FREAL
BEGIN
RETURN((P1 + 1.0))
END FREAL
ROUTINE RTEST
VAR
S1 : INTEGER
S2 : INTEGER
U2C_3 : INTEGER
U2C_4 : REAL
U2C_5 : REAL
U2C_6 : REAL
S3 : INTEGER
U2C_8 : REAL
BEGIN
S1=7
S2=3
U2C_3=2
U2C_4=2.5
U2C_5=4.5
U2C_6=1.5
S3=(S1 - S2)
END RTEST
BEGIN
RTEST(7,2.5)
END MP0009
