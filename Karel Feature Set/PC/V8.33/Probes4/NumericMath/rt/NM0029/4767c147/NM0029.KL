PROGRAM NM0029
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE IDI(P1 : INTEGER) : INTEGER FROM NM0029
ROUTINE IDR(P1 : REAL) : REAL FROM NM0029
ROUTINE RTEST FROM NM0029
ROUTINE IDI
BEGIN
RETURN((P1 + 1))
END IDI
ROUTINE IDR
BEGIN
RETURN((P1 + 1.0))
END IDR
ROUTINE RTEST
VAR
L1 : STRING[8]
L2 : ARRAY[3] OF INTEGER
L3 : ARRAY[3] OF REAL
U2C_12 : INTEGER
U2C_13 : INTEGER
S1 : REAL
U2C_15 : REAL
U2C_16 : BOOLEAN
BEGIN
U2C_12=1
U2C_13=2
S1=2.5
U2C_15=3.5
U2C_16=TRUE
L1='A'
L2[1]=2
L3[1]=2.5
S1=ABS(U2C_12)
END RTEST
BEGIN
RTEST
END NM0029
