PROGRAM IO0196
%NOLOCKGROUP
ROUTINE RTEST
VAR
L1 : ARRAY[3] OF INTEGER;L2 : XYZWPR
L3 : JOINTPOS9
L4 : POSITION
S1:INTEGER
S2:INTEGER
A:REAL
B:BOOLEAN
C:REAL
BEGIN
--                                 
--                                 
S1=1    
L1[1]=2    
B=TRUE     
C=1.0     
L2=GET_POS_REG(1,S2,1)        
IF (L2.X>0.0) THEN  
S1=(S1+1)     
ENDIF   
END RTEST
BEGIN  
RTEST   
END IO0196
