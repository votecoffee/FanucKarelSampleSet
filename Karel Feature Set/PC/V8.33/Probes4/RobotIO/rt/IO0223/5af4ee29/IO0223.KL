PROGRAM IO0223
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE RTEST FROM IO0223
ROUTINE RTEST
VAR
L1 : ARRAY[3] OF INTEGER
L2 : XYZWPR
L3 : JOINTPOS9
L4 : POSITION
S1 : INTEGER
S2 : INTEGER
S3 : INTEGER
U2C_40 : BOOLEAN
U2C_41 : REAL
BEGIN
S1=1
L1[1]=2
U2C_40=TRUE
U2C_41=1.0
GET_VAR(S3,'*SYSTEM*','$MNUTOOLNUM[1]',S1,S2)
END RTEST
BEGIN
RTEST
END IO0223
