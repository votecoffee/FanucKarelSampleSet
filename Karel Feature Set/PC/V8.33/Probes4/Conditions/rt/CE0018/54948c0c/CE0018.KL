PROGRAM CE0018
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE RB(P1 : BOOLEAN) : BOOLEAN FROM CE0018
ROUTINE RI(P1 : INTEGER) : INTEGER FROM CE0018
ROUTINE RR(P1 : REAL) : REAL FROM CE0018
ROUTINE RTEST FROM CE0018
ROUTINE RB
BEGIN
RETURN(P1)
-- UNRESOLVED_PC line 6 opcodes [7F] marker_code=16
END RB
ROUTINE RI
BEGIN
RETURN((P1 + 1))
END RI
ROUTINE RR
BEGIN
RETURN((P1 + 1.0))
END RR
ROUTINE RTEST
VAR
L1 : STRING[20]
L2 : STRING[20]
L3 : ARRAY[3] OF INTEGER
S1 : INTEGER
U2C_18 : INTEGER
U2C_19 : REAL
U2C_20 : REAL
U2C_21 : INTEGER
U2C_22 : INTEGER
BEGIN
S1=2
U2C_18=3
U2C_19=2.5
U2C_20=3.5
U2C_21=1
U2C_22=0
L1='AB'
L2='AC'
L3[1]=2
L3[2]=3
IF (U2C_21 < U2C_22) THEN
S1=(S1 + 1)
ELSE
S1=(S1 + 2)
ENDIF
END RTEST
BEGIN
RTEST
END CE0018
