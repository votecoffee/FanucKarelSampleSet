PROGRAM CE0146
%NOLOCKGROUP
ROUTINE RB(P1:BOOLEAN):BOOLEAN
BEGIN
RETURN(P1)
END RB
ROUTINE RI(P1:INTEGER):INTEGER
BEGIN
RETURN((P1 + 1))
END RI
ROUTINE RR(P1:REAL):REAL
BEGIN
RETURN((P1 + 1.0))
END RR
ROUTINE RTEST
VAR
A : STRING[20];B : STRING[20];L3 : ARRAY[3] OF INTEGER;S1:INTEGER;C:INTEGER;D:REAL;E:REAL;G:INTEGER;H:INTEGER
BEGIN
S1=2
C=3
D=2.5
E=3.5
G=1
H=0
A='AB'
B='AC'
L3[1]=2
L3[2]=3
IF (G <=H) THEN
S1=(S1 + 1)
ELSE
S1=(S1 + 2)
ENDIF
END RTEST
BEGIN
RTEST
END CE0146
