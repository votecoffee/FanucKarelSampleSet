PROGRAM MP0080
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE FINT(P1 : INTEGER) : INTEGER FROM MP0080
ROUTINE FREAL(P1 : REAL) : REAL FROM MP0080
ROUTINE RTEST(P1 : INTEGER; P2 : REAL) FROM MP0080
ROUTINE FINT
BEGIN
RETURN((P1 + 1))
END FINT
ROUTINE FREAL
BEGIN
RETURN((P1 + 1.0))
END FREAL
ROUTINE RTEST
VAR
L1 : ARRAY[3] OF REAL
U2C_5 : INTEGER
U2C_6 : INTEGER
U2C_7 : INTEGER
U2C_8 : REAL
U2C_9 : REAL
U2C_10 : REAL
U2C_11 : REAL
S1 : REAL
BEGIN
U2C_5=7
U2C_6=3
U2C_7=2
U2C_8=2.5
U2C_9=4.5
U2C_10=1.5
L1[1]=2.5
S1=(L1[1] * U2C_9)
END RTEST
BEGIN
RTEST(7,2.5)
END MP0080
