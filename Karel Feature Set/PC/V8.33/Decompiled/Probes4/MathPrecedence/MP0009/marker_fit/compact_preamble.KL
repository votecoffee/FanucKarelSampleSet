PROGRAM MP0009
%NOLOCKGROUP
ROUTINE FINT(P1:INTEGER):INTEGER
BEGIN
RETURN((P1 + 1))
END FINT
ROUTINE FREAL(P1:REAL):REAL
BEGIN
RETURN((P1 + 1.0))
END FREAL
ROUTINE RTEST(P1:INTEGER;P2:REAL)
VAR
S1:INTEGER;S2:INTEGER;A:INTEGER;B:REAL;C:REAL;D:REAL;S3:INTEGER;E:REAL
BEGIN
S1=7
S2=3
A=2
B=2.5
C=4.5
D=1.5
S3=(S1 - S2)
END RTEST
BEGIN
RTEST(7,2.5)
END MP0009
