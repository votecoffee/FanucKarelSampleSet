PROGRAM MP0050
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE FINT(P1 : INTEGER) : INTEGER FROM MP0050
ROUTINE FREAL(P1 : REAL) : REAL FROM MP0050
ROUTINE RTEST(P1 : INTEGER; P2 : REAL) FROM MP0050
ROUTINE FINT
BEGIN
RETURN((P1 + 1))
END FINT
ROUTINE FREAL
BEGIN
RETURN((P1 + 1.0))
END FREAL
ROUTINE RTEST
VAR
U2C_1 : BOOLEAN
U2C_2 : BOOLEAN
U2C_3 : INTEGER
U2C_4 : REAL
U2C_5 : REAL
U2C_6 : REAL
U2C_7 : REAL
S1 : REAL
BEGIN
U2C_1=7
U2C_2=3
U2C_3=2
U2C_4=2.5
U2C_5=4.5
U2C_6=1.5
S1=((U2C_1 AND U2C_2))
END RTEST
BEGIN
RTEST(7,2.5)
END MP0050
