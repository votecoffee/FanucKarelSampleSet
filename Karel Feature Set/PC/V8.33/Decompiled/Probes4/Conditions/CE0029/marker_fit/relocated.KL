PROGRAM CE0029
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE RB(P1 : BOOLEAN) : BOOLEAN FROM CE0029
ROUTINE RI(P1 : INTEGER) : INTEGER FROM CE0029
ROUTINE RR(P1 : REAL) : REAL FROM CE0029
ROUTINE RTEST FROM CE0029
ROUTINE RB
BEGIN
RETURN(P1)
END RB
ROUTINE RI
BEGIN
RETURN((P1 + 1))
END RI
ROUTINE RR
BEGIN
RETURN((P1 + 1.0))
END RR
ROUTINE RTEST
VAR
L1 : STRING[20]
L2 : STRING[20]
L3 : ARRAY[3] OF INTEGER
S1 : INTEGER
U2C_18 : INTEGER
U2C_19 : REAL
U2C_20 : REAL
U2C_21 : BOOLEAN
U2C_22 : BOOLEAN
BEGIN
S1=2
U2C_18=3
U2C_19=2.5
U2C_20=3.5
U2C_21=TRUE
U2C_22=FALSE
L1='AB'
L2='AC'
L3[1]=2
L3[2]=3
IF (U2C_21 OR (U2C_22 AND U2C_21)) THEN
S1=(S1 + 1)
ELSE
S1=(S1 + 2)
ENDIF
END RTEST
BEGIN
RTEST
END CE0029
