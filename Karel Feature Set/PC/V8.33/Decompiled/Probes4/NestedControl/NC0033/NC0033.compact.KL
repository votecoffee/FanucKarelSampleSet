PROGRAM NC0033
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE R FROM NC0033
ROUTINE R
VAR
S1 : INTEGER
BEGIN
S1=1
SELECT S1 OF
CASE(1):
S1=(S1 + 2)
CASE(2):
S1=(S1 + 3)
ELSE:
SELECT S1 OF
CASE(1):
S1=(S1 + 2)
CASE(2):
S1=(S1 + 3)
ELSE:
S1=(S1 + 1)
ENDSELECT
ENDSELECT
END R
BEGIN
R
END NC0033
