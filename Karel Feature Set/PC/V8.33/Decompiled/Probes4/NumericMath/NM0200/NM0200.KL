PROGRAM NM0200
%STACKSIZE=65535
%PRIORITY=65535
%NOLOCKGROUP
ROUTINE IDI(P1 : INTEGER) : INTEGER FROM NM0200
ROUTINE IDR(P1 : REAL) : REAL FROM NM0200
ROUTINE RTEST FROM NM0200
ROUTINE IDI
BEGIN
RETURN((P1 + 1))
END IDI
ROUTINE IDR
BEGIN
RETURN((P1 + 1.0))
END IDR
ROUTINE RTEST
VAR
L1 : STRING[8]
L2 : ARRAY[3] OF INTEGER
L3 : ARRAY[3] OF REAL
U2C_12 : BOOLEAN
U2C_13 : INTEGER
S1 : REAL
U2C_15 : REAL
U2C_16 : BOOLEAN
BEGIN
U2C_12=TRUE
U2C_13=2
S1=2.5
U2C_15=3.5
U2C_16=TRUE
L1='A'
L2[1]=2
L3[1]=2.5
-- UNRESOLVED_PC line 30 opcodes [27 27 21 2E 6B 2E 69 76 64 23] marker_code=200
END RTEST
BEGIN
RTEST
END NM0200
