PROGRAM NM0029
%NOLOCKGROUP
ROUTINE IDI(P1:INTEGER):INTEGER
BEGIN      
RETURN((P1+1))  
END IDI
ROUTINE IDR(P1:REAL):REAL
BEGIN     
RETURN((P1+1.0))  
END IDR
ROUTINE RTEST
VAR
B : STRING[8];L2 : ARRAY[3] OF INTEGER;L3 : ARRAY[3] OF REAL;C:INTEGER;D:INTEGER;S1:REAL;E:REAL;F:BOOLEAN
BEGIN
--   
--   
--  
--  
--  
--  
--  
C=1     
D=2     
S1=2.5    
E=3.5     
F=TRUE     
B='A'     
L2[1]=2     
L3[1]=2.5     
S1=ABS(C)    
END RTEST
BEGIN  
RTEST   
END NM0029
