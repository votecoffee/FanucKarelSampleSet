PROGRAM KS00062
%NOLOCKGROUP
TYPE
  REC_T = STRUCTURE
    VALUE: INTEGER
    FLAG: BOOLEAN
  ENDSTRUCTURE
VAR
  A: ARRAY[4] OF PATH
  B: ARRAY[4] OF PATH
  FLAG: BOOLEAN
  N: INTEGER
  STATUS: INTEGER
  PN: STRING[80]
  VN: STRING[80]
BEGIN
  PN = ''
  VN = 'A'
  GET_VAR(N, PN, VN, A, STATUS)
END KS00062
