PROGRAM KC00061
%NOLOCKGROUP
VAR
  I: INTEGER
  J: INTEGER
  K: INTEGER
  R: REAL
  B: BOOLEAN
  S: STRING[80]
  T: STRING[80]
  P: PATH
  Q: PATH
  AI: ARRAY[8] OF INTEGER
  AB: ARRAY[244] OF BYTE
  XP: XYZWPR
ROUTINE IRVU_VRGETVIEW(VR_NUM: INTEGER; VIEW_NUM: INTEGER; FOUND_POS: XYZWPR; MODEL_ID: INTEGER): INTEGER FROM IRVUTILVR
