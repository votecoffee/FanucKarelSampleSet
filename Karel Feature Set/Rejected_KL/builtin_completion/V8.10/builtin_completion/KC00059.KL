PROGRAM KC00059
%NOLOCKGROUP
VAR
  I: INTEGER
  J: INTEGER
  K: INTEGER
  R: REAL
  B: BOOLEAN
  S: STRING[80]
  T: STRING[80]
  P: PATH
  Q: PATH
  AI: ARRAY[8] OF INTEGER
  AB: ARRAY[244] OF BYTE
ROUTINE IRVU_VRGETMEAS(VR_NUM: INTEGER; MEAS_NUM: INTEGER; MEAS_VAL: REAL): INTEGER FROM IRVUTILVR
