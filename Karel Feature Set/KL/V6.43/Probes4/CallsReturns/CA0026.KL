PROGRAM CA0026
%NOLOCKGROUP
TYPE
  T = STRUCTURE
    A : INTEGER
    B : REAL
  ENDSTRUCTURE
VAR
  G : INTEGER
  I : INTEGER
  R : REAL
  B : BOOLEAN
  S : STRING[16]
  AI : ARRAY[2] OF INTEGER
  AR : ARRAY[2] OF REAL
  ST : T
  P : XYZWPR
  V : VECTOR
ROUTINE F(P1 : ARRAY[*] OF INTEGER;
  P2 : ARRAY[*] OF REAL;
  P3 : T;
  P4 : XYZWPR;
  P5 : VECTOR)
BEGIN
  G = G + 1
END F
BEGIN
  G = 0
  I = 1
  R = 2.5
  B = TRUE
  S = 'A'
  AI[1] = 3
  AR[1] = 4.5
  ST.A = 5
  ST.B = 6.5
  F(AI,
  AR,
  ST,
  P,
  V)
END CA0026
