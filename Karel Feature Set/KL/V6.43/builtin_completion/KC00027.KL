PROGRAM KC00027
%NOLOCKGROUP
%ENVIRONMENT MOTN
VAR
  I: INTEGER
  J: INTEGER
  K: INTEGER
  R: REAL
  B: BOOLEAN
  S: STRING[80]
  T: STRING[80]
  P: PATH
  Q: PATH
  AI: ARRAY[8] OF INTEGER
  AB: ARRAY[244] OF BYTE
  JP: JOINTPOS
  P1: POSITION
  P2: POSITION
  P3: POSITION
  C: CONFIG
  AR: ARRAY[9] OF REAL
BEGIN
  JOINT2POS(JP,P1,P2,I,P3,C,AR,J)
END KC00027
