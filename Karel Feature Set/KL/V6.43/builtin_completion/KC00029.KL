PROGRAM KC00029
%NOLOCKGROUP
%ENVIRONMENT UIF
VAR
  I: INTEGER
  J: INTEGER
  K: INTEGER
  R: REAL
  B: BOOLEAN
  S: STRING[80]
  T: STRING[80]
  P: PATH
  Q: PATH
  AI: ARRAY[8] OF INTEGER
  AB: ARRAY[244] OF BYTE
  CD: ARRAY[8] OF COL_DESC_T
  BA: ARRAY[8] OF BOOLEAN
  BB: ARRAY[8,8] OF BOOLEAN
  SA: ARRAY[8] OF STRING[80]
BEGIN
  S = 'DICT'
  DISCTRL_TBL(S,I,J,K,CD,BA,BB,I,J,K,SA,B,I)
END KC00029
