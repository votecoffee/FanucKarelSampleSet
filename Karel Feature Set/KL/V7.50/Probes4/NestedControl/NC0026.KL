PROGRAM NC0026
%NOLOCKGROUP
ROUTINE R
VAR
  X : INTEGER
BEGIN
  X = 1
  SELECT X OF
    CASE(1):
      SELECT X OF
        CASE(1):
          SELECT X OF
            CASE(1):
              SELECT X OF
                CASE(1):
                  SELECT X OF
                    CASE(1):
                      SELECT X OF
                        CASE(1):
                          SELECT X OF
                            CASE(1):
                              SELECT X OF
                                CASE(1):
                                  X = X + 1
                                CASE(2):
                                  X = X + 2
                                ELSE:
                                  X = X + 3
                              ENDSELECT
                            CASE(2):
                              X = X + 2
                            ELSE:
                              X = X + 3
                          ENDSELECT
                        CASE(2):
                          X = X + 2
                        ELSE:
                          X = X + 3
                      ENDSELECT
                    CASE(2):
                      X = X + 2
                    ELSE:
                      X = X + 3
                  ENDSELECT
                CASE(2):
                  X = X + 2
                ELSE:
                  X = X + 3
              ENDSELECT
            CASE(2):
              X = X + 2
            ELSE:
              X = X + 3
          ENDSELECT
        CASE(2):
          X = X + 2
        ELSE:
          X = X + 3
      ENDSELECT
    CASE(2):
      X = X + 2
    ELSE:
      X = X + 3
  ENDSELECT
END R
BEGIN
  R
END NC0026
