PROGRAM NC0068
%NOLOCKGROUP
ROUTINE R
VAR
  X : INTEGER
  I1 : INTEGER
  I2 : INTEGER
  I3 : INTEGER
  I4 : INTEGER
  I5 : INTEGER
  I6 : INTEGER
  I7 : INTEGER
  I8 : INTEGER
  I9 : INTEGER
  I10 : INTEGER
  I11 : INTEGER
  I12 : INTEGER
BEGIN
  X = 1
  FOR I1 = 1 TO 2 DO
    FOR I2 = 1 TO 2 DO
      FOR I3 = 1 TO 2 DO
        FOR I4 = 1 TO 2 DO
          FOR I5 = 1 TO 2 DO
            FOR I6 = 1 TO 2 DO
              FOR I7 = 1 TO 2 DO
                FOR I8 = 1 TO 2 DO
                  FOR I9 = 1 TO 2 DO
                    FOR I10 = 1 TO 2 DO
                      FOR I11 = 1 TO 2 DO
                        FOR I12 = 1 TO 2 DO
                          X = X + 1
                        ENDFOR
                      ENDFOR
                    ENDFOR
                  ENDFOR
                ENDFOR
              ENDFOR
            ENDFOR
          ENDFOR
        ENDFOR
      ENDFOR
    ENDFOR
  ENDFOR
END R
BEGIN
  R
END NC0068
