PROGRAM CE0099
%NOLOCKGROUP
ROUTINE RB(P : BOOLEAN): BOOLEAN
BEGIN
  RETURN(P)
END RB
ROUTINE RI(P : INTEGER): INTEGER
BEGIN
  RETURN(P + 1)
END RI
ROUTINE RR(P : REAL): REAL
BEGIN
  RETURN(P + 1.0)
END RR
ROUTINE RTEST
VAR
  I : INTEGER
  J : INTEGER
  R : REAL
  T : REAL
  B : BOOLEAN
  C : BOOLEAN
  S : STRING[20]
  U : STRING[20]
  A : ARRAY[3] OF INTEGER
BEGIN
  I = 2
  J = 3
  R = 2.5
  T = 3.5
  B = TRUE
  C = FALSE
  S = 'AB'
  U = 'AC'
  A[1] = 2
  A[2] = 3
  IF R + 1.0 > T / 2.0 THEN
    I = I + 1
  ELSE
    I = I + 2
  ENDIF
END RTEST
BEGIN
  RTEST
END CE0099
