PROGRAM IO0081
%NOLOCKGROUP
ROUTINE RTEST
VAR
  I : INTEGER
  STATUS : INTEGER
  ENTRY : INTEGER
  A : ARRAY[3] OF INTEGER
  B : BOOLEAN
  R : REAL
  P : XYZWPR
  JPOS : JOINTPOS
  PF : POSITION
BEGIN
  I = 1
  A[1] = 2
  B = TRUE
  R = 1.0
  IF AOUT[17] > 0 THEN
    I = I + 1
  ENDIF
END RTEST
BEGIN
  RTEST
END IO0081
