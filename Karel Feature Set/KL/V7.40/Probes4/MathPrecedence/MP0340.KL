PROGRAM MP0340
%NOLOCKGROUP
ROUTINE FINT(A : INTEGER): INTEGER
BEGIN
  RETURN(A + 1)
END FINT
ROUTINE FREAL(A : REAL): REAL
BEGIN
  RETURN(A + 1.0)
END FREAL
ROUTINE RTEST(P : INTEGER; Q : REAL)
VAR
  I : INTEGER
  J : INTEGER
  K : INTEGER
  R : REAL
  T : REAL
  U : REAL
  X : INTEGER
  Y : REAL
BEGIN
  I = 7
  J = 3
  K = 2
  R = 2.5
  T = 4.5
  U = 1.5
  Y = R / 1.23456789
END RTEST
BEGIN
  RTEST(7,2.5)
END MP0340
