PROGRAM KF00081
%NOLOCKGROUP
%ENVIRONMENT PBQMGR
VAR
  I: INTEGER
  J: INTEGER
  X: REAL
  Y: REAL
  B: BOOLEAN
  C: BOOLEAN
  TXT: STRING[80]
  TXT2: STRING[80]
  AI: ARRAY[4] OF INTEGER
  BI: ARRAY[4] OF INTEGER
  P: XYZWPR
  JP: JOINTPOS
  PF: POSITION
  V1: VECTOR
  V2: VECTOR
  STATUS: INTEGER
  QT: QUEUE_TYPE
BEGIN
  INIT_QUEUE(QT)
  APPEND_QUEUE(3, QT, AI, J, STATUS)
END KF00081
