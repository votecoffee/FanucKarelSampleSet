PROGRAM KC00023
%NOLOCKGROUP
VAR
  I: INTEGER
  J: INTEGER
  K: INTEGER
  R: REAL
  B: BOOLEAN
  S: STRING[80]
  T: STRING[80]
  P: PATH
  Q: PATH
  AI: ARRAY[8] OF INTEGER
  AB: ARRAY[244] OF BYTE
ROUTINE BUMP(N: INTEGER)
BEGIN
  N = N + 1
END BUMP
BEGIN
  S = ''
  T = 'I'
  BUMP(BYNAME(S,T,J))
END KC00023
