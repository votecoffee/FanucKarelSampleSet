PROGRAM NC0061
%NOLOCKGROUP
ROUTINE R
VAR
  X : INTEGER
BEGIN
  X = 1
  SELECT X OF
    CASE(1):
      X = X + 2
    CASE(2):
      X = X + 3
    ELSE:
      IF X = 1 THEN
        X = X + 2
      ELSE
        SELECT X OF
          CASE(1):
            X = X + 2
          CASE(2):
            X = X + 3
          ELSE:
            IF X = 1 THEN
              X = X + 2
            ELSE
              SELECT X OF
                CASE(1):
                  X = X + 2
                CASE(2):
                  X = X + 3
                ELSE:
                  IF X = 1 THEN
                    X = X + 2
                  ELSE
                    SELECT X OF
                      CASE(1):
                        X = X + 2
                      CASE(2):
                        X = X + 3
                      ELSE:
                        IF X = 1 THEN
                          X = X + 2
                        ELSE
                          SELECT X OF
                            CASE(1):
                              X = X + 2
                            CASE(2):
                              X = X + 3
                            ELSE:
                              IF X = 1 THEN
                                X = X + 2
                              ELSE
                                SELECT X OF
                                  CASE(1):
                                    X = X + 2
                                  CASE(2):
                                    X = X + 3
                                  ELSE:
                                    IF X = 1 THEN
                                      X = X + 2
                                    ELSE
                                      SELECT X OF
                                        CASE(1):
                                          X = X + 2
                                        CASE(2):
                                          X = X + 3
                                        ELSE:
                                          IF X = 1 THEN
                                            X = X + 2
                                          ELSE
                                            SELECT X OF
                                              CASE(1):
                                                X = X + 2
                                              CASE(2):
                                                X = X + 3
                                              ELSE:
                                                IF X = 1 THEN
                                                  X = X + 2
                                                ELSE
                                                  SELECT X OF
                                                    CASE(1):
                                                      X = X + 2
                                                    CASE(2):
                                                      X = X + 3
                                                    ELSE:
                                                      IF X = 1 THEN
                                                        X = X + 2
                                                      ELSE
                                                        SELECT X OF
                                                          CASE(1):
                                                            X = X + 2
                                                          CASE(2):
                                                            X = X + 3
                                                          ELSE:
                                                            IF X = 1 THEN
                                                              X = X + 2
                                                            ELSE
                                                              X = X + 1
                                                            ENDIF
                                                        ENDSELECT
                                                      ENDIF
                                                  ENDSELECT
                                                ENDIF
                                            ENDSELECT
                                          ENDIF
                                      ENDSELECT
                                    ENDIF
                                ENDSELECT
                              ENDIF
                          ENDSELECT
                        ENDIF
                    ENDSELECT
                  ENDIF
              ENDSELECT
            ENDIF
        ENDSELECT
      ENDIF
  ENDSELECT
END R
BEGIN
  R
END NC0061
