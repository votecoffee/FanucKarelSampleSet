PROGRAM IO0209
%NOLOCKGROUP
%ENVIRONMENT REGOPE
ROUTINE RTEST
VAR
  I : INTEGER
  STATUS : INTEGER
  ENTRY : INTEGER
  A : ARRAY[3] OF INTEGER
  B : BOOLEAN
  R : REAL
  P : XYZWPR
  JPOS : JOINTPOS
  PF : POSITION
BEGIN
  I = 1
  A[1] = 2
  B = TRUE
  R = 1.0
  SET_REAL_REG(1,R,STATUS)
END RTEST
BEGIN
  RTEST
END IO0209
