PROGRAM NC0046
%NOLOCKGROUP
ROUTINE R
VAR
  X : INTEGER
BEGIN
  X = 1
  IF X = 1 THEN
    SELECT X OF
      CASE(1):
        IF X = 1 THEN
          SELECT X OF
            CASE(1):
              IF X = 1 THEN
                SELECT X OF
                  CASE(1):
                    IF X = 1 THEN
                      SELECT X OF
                        CASE(1):
                          X = X + 1
                        CASE(2):
                          X = X + 2
                        ELSE:
                          X = X + 3
                      ENDSELECT
                    ELSE
                      X = X + 2
                    ENDIF
                  CASE(2):
                    X = X + 2
                  ELSE:
                    X = X + 3
                ENDSELECT
              ELSE
                X = X + 2
              ENDIF
            CASE(2):
              X = X + 2
            ELSE:
              X = X + 3
          ENDSELECT
        ELSE
          X = X + 2
        ENDIF
      CASE(2):
        X = X + 2
      ELSE:
        X = X + 3
    ENDSELECT
  ELSE
    X = X + 2
  ENDIF
END R
BEGIN
  R
END NC0046
