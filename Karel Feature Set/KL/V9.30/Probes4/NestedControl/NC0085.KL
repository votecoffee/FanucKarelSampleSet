PROGRAM NC0085
%NOLOCKGROUP
ROUTINE R
VAR
  X : INTEGER
  I3 : INTEGER
BEGIN
  X = 1
  IF X = 1 THEN
    SELECT X OF
      CASE(1):
        FOR I3 = 1 TO 2 DO
          WHILE X < 2 DO
            IF X = 1 THEN
              X = X + 1
            ELSE
              X = X + 2
            ENDIF
          ENDWHILE
        ENDFOR
      CASE(2):
        X = X + 2
      ELSE:
        X = X + 3
    ENDSELECT
  ELSE
    X = X + 2
  ENDIF
END R
BEGIN
  R
END NC0085
