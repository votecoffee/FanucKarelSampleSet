PROGRAM KF00049
%NOLOCKGROUP
VAR
  I: INTEGER
  J: INTEGER
  X: REAL
  Y: REAL
  B: BOOLEAN
  C: BOOLEAN
  TXT: STRING[80]
  TXT2: STRING[80]
  AI: ARRAY[4] OF INTEGER
  BI: ARRAY[4] OF INTEGER
  P: XYZWPR
  JP: JOINTPOS
  PF: POSITION
  V1: VECTOR
  V2: VECTOR
  STATUS: INTEGER
BEGIN
  I = 2
  SELECT I OF
    CASE(1,2): J = 10
    ELSE: J = 20
  ENDSELECT
END KF00049
