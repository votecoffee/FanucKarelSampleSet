PROGRAM NC0065
%NOLOCKGROUP
ROUTINE R
VAR
  X : INTEGER
  I1 : INTEGER
  I2 : INTEGER
  I3 : INTEGER
  I4 : INTEGER
  I5 : INTEGER
BEGIN
  X = 1
  FOR I1 = 1 TO 2 DO
    FOR I2 = 1 TO 2 DO
      FOR I3 = 1 TO 2 DO
        FOR I4 = 1 TO 2 DO
          FOR I5 = 1 TO 2 DO
            X = X + 1
          ENDFOR
        ENDFOR
      ENDFOR
    ENDFOR
  ENDFOR
END R
BEGIN
  R
END NC0065
