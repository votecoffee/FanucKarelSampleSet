PROGRAM NM0032
%NOLOCKGROUP
ROUTINE IDI(P : INTEGER): INTEGER
BEGIN
  RETURN(P + 1)
END IDI
ROUTINE IDR(P : REAL): REAL
BEGIN
  RETURN(P + 1.0)
END IDR
ROUTINE RTEST
VAR
  I : INTEGER
  J : INTEGER
  R : REAL
  T : REAL
  B : BOOLEAN
  S : STRING[8]
  AI : ARRAY[3] OF INTEGER
  AR : ARRAY[3] OF REAL
BEGIN
  I = 1
  J = 2
  R = 2.5
  T = 3.5
  B = TRUE
  S = 'A'
  AI[1] = 2
  AR[1] = 2.5
  R = ABS(-7)
END RTEST
BEGIN
  RTEST
END NM0032
