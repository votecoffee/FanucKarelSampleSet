PROGRAM KC00060
%NOLOCKGROUP
VAR
  I: INTEGER
  J: INTEGER
  K: INTEGER
  R: REAL
  B: BOOLEAN
  S: STRING[80]
  T: STRING[80]
  P: PATH
  Q: PATH
  AI: ARRAY[8] OF INTEGER
  AB: ARRAY[244] OF BYTE
  XP: XYZWPR
ROUTINE IRVU_VRGETOFFSET(VR_NUM: INTEGER; OFFSET: XYZWPR; FRAME_NUM: INTEGER; COMMENT_STR: STRING): INTEGER FROM IRVUTILVR
BEGIN
  I = IRVU_VRGETOFFSET(1,XP,J,S)
END KC00060
