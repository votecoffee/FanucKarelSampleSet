PROGRAM NC0076
%NOLOCKGROUP
ROUTINE R
VAR
  X : INTEGER
BEGIN
  X = 1
  WHILE X < 2 DO
    WHILE X < 2 DO
      WHILE X < 2 DO
        WHILE X < 2 DO
          WHILE X < 2 DO
            WHILE X < 2 DO
              WHILE X < 2 DO
                WHILE X < 2 DO
                  X = X + 1
                ENDWHILE
              ENDWHILE
            ENDWHILE
          ENDWHILE
        ENDWHILE
      ENDWHILE
    ENDWHILE
  ENDWHILE
END R
BEGIN
  R
END NC0076
