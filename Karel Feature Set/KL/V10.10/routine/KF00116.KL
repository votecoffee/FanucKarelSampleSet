PROGRAM KF00116
%NOLOCKGROUP
VAR
  I: INTEGER
  J: INTEGER
  X: REAL
  Y: REAL
  B: BOOLEAN
  C: BOOLEAN
  TXT: STRING[80]
  TXT2: STRING[80]
  AI: ARRAY[4] OF INTEGER
  BI: ARRAY[4] OF INTEGER
  P: XYZWPR
  JP: JOINTPOS
  PF: POSITION
  V1: VECTOR
  V2: VECTOR
  STATUS: INTEGER
ROUTINE FACT(V: INTEGER): INTEGER
BEGIN
  IF V <= 1 THEN
    RETURN(1)
  ELSE
    RETURN(V * FACT(V - 1))
  ENDIF
END FACT
BEGIN
  I = FACT(3)
END KF00116
